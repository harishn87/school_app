# --- Core ---
ENV=development                      # set to "production" on the server
MONGO_URL=mongodb://localhost:27017
PLATFORM_DB=scholaris_platform       # platform data: schools, super admins
TENANT_DB_PREFIX=school_             # each school gets its own database: school_<code>

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false                  # true in production (HTTPS)
CORS_ORIGINS=http://localhost:3000

# --- Platform owner (super admin console at /platform) ---
SUPERADMIN_EMAIL=owner@example.com
SUPERADMIN_PASSWORD=change-me-strong-password

# --- SaaS ---
TRIAL_DAYS=14
ALLOW_SIGNUP=true
SEED_DEMO=true                       # demo school (code "demo", admin@school.com / admin123); false in production
