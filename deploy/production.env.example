# Copy to deploy/production.env and fill in. Never commit the real file.

# Your domain (DNS A record must point at this server) and email for Let's Encrypt
DOMAIN=app.yourschoolsaas.com
ACME_EMAIL=you@example.com

# MongoDB root credentials (generate: openssl rand -hex 24)
MONGO_ROOT_USER=scholaris
MONGO_ROOT_PASSWORD=

# JWT signing key, at least 32 chars (generate: openssl rand -hex 32)
JWT_SECRET=

# Platform owner login for /platform (password at least 12 chars)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

TRIAL_DAYS=14
ALLOW_SIGNUP=true
WEB_CONCURRENCY=2
